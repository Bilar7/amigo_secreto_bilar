rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Proteção temporária: negar acesso público enquanto a aplicação não usar
    // Firebase Authentication e documentos normalizados com membership verificável.
    // Não substitua por `allow read, write: if true`.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
